# ── Chameleon Bridge ──────────────────────────────────────────────────
# Top-level env for the entire bot stack
# Copy to .env and fill in your values

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# WhatsApp (Evolution API)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
WHATSAPP_INSTANCE_NAME=chameleon

# RSS Scanner
RSS_SCAN_INTERVAL_MINUTES=60
RSS_SCAN_QUERIES=python,rust,ai engineer
RSS_SCAN_PLATFORMS=remoteok,remotive,hn_hiring
RSS_SCAN_LIMIT=10
RSS_SCORE_THRESHOLD=40
RSS_HIGH_SCORE_THRESHOLD=70

# Webhook
WEBHOOK_SECRET=change-me-to-a-random-string

# OpenCode (must be running separately)
# Set OC_ENABLED=false to force bridge-only mode (no SDK import attempted)
OC_ENABLED=true
OPENCODE_API_URL=http://localhost:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_MODEL_PROVIDER=anthropic
OPENCODE_MODEL_ID=claude-sonnet-4-20250514
